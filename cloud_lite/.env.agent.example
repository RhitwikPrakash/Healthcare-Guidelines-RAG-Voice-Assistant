# EXAMPLE ONLY. Secrets for the LiveKit voice worker.
# On LiveKit Cloud, LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET are
# injected automatically and CANNOT be set as secrets: delete those three lines
# from the file you pass to `lk agent create --secrets-file=...`.
# For local `python voice_agent.py dev`, copy to cloud_lite/.env.local (git-ignored).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=healthcare-rag-voice
# Must equal VOICE_CONTEXT_SECRET in Streamlit secrets (32+ random characters).
VOICE_CONTEXT_SECRET=replace-with-the-same-long-random-string

OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-gemini-api-key
# OPENAI_MODEL=gpt-5.4-mini
# GEMINI_MODEL=gemini-2.5-flash

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-private-server-only-key

# Speech models via LiveKit Inference (billed to the LiveKit project).
# VOICE_STT_MODEL=deepgram/nova-3
# VOICE_STT_FALLBACK=assemblyai/universal-streaming
# VOICE_TTS_MODEL=deepgram/aura-2
# VOICE_TTS_FALLBACK=cartesia/sonic-3
# VOICE_TTS_VOICE=
# VOICE_MAX_SESSION_MINUTES=10
# VOICE_MAX_QUESTIONS_PER_SESSION=20
