# EXAMPLE ONLY -- NEVER PUT ACTUAL CREDENTIALS IN A COMMITTED FILE.
OPENAI_API_KEY = "your-openai-api-key"
GOOGLE_API_KEY = "your-gemini-api-key"

# Supabase Project Settings -> API keys (new-format sb_secret_... key)
# Chat text and PDF evidence excerpts expire 72 hours after last update.
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_replace-with-private-server-only-key"

# ---- OPTIONAL: LiveKit real-time voice assistant ----------------------------
# Leave these out and the "Enable Voice Assistant" toggle shows "not configured";
# the text application is unaffected. Requires SUPABASE_VOICE_SCHEMA.sql.
# LiveKit Cloud project -> Settings -> API keys. The secret stays server-side:
# it signs short-lived browser tokens and derives the context-encryption key.
LIVEKIT_URL = "wss://your-project.livekit.cloud"
LIVEKIT_API_KEY = "your-livekit-api-key"
LIVEKIT_API_SECRET = "your-livekit-api-secret"
LIVEKIT_AGENT_NAME = "healthcare-rag-voice"
# Random 32+ character string shared ONLY with the LiveKit agent (same value in
# both places). Encrypts the temporary PDF context. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VOICE_CONTEXT_SECRET = "replace-with-a-long-random-string"
# Optional cost/abuse limits (defaults shown).
# VOICE_MAX_SESSIONS_PER_HOUR = "6"
# VOICE_TOKEN_TTL_MINUTES = "10"
# VOICE_CONTEXT_TTL_MINUTES = "120"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generated-long-random-string"
client_id = "google-oauth-client-id"
client_secret = "google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
